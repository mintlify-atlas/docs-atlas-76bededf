{
  "projectType": "frontend",
  "projectName": "Serpantinum",
  "projectDescription": "A feature-rich, highly customizable shell for Wayland compositors (Hyprland, Niri, Sway) built with Quickshell and QML.",
  "theme": "willow",
  "primaryColor": "#8c8c8c",
  "lightColor": "#252525",
  "darkColor": "#cecece",
  "navigation": {
